    },
    {
      "id": "nvngx-dlssnr",
      "name": "DLSS 5 Modell (nvngx_dlssnr.dll)",
      "description": "NVIDIAs Neural-Rendering-Modell. Wird aus dem installierten Treiber (ab 616.56) übernommen.",
      "license": "NVIDIA (Teil des Treibers)",
      "source": { "type": "DriverStore", "fileName": "nvngx_dlssnr.dll" },
      "expectedFiles": [ "nvngx_dlssnr.dll" ],
