    },
    {
      "id": "nvngx-dlss",
      "name": "DLSS-Laufzeit (nvngx_dlss.dll)",
      "description": "DLSS Super Resolution/DLAA. Wird aus einem installierten Spiel übernommen oder bei NVIDIA geladen.",
      "license": "NVIDIA DLSS SDK",
      "homepage": "https://github.com/NVIDIA/DLSS",
      "source": {
        "type": "GameLibrary",
