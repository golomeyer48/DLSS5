      },
      "expectedFiles": [ "nvngx_dlss.dll" ]
    },
    {
      "id": "presentmon",
      "name": "PresentMon",
      "description": "Intels Messwerkzeug für Bildraten und Latenz (ETW). Wird für Testläufe und Benchmarks gebraucht.",
      "license": "MIT",
      "homepage": "https://github.com/GameTechDev/PresentMon",
      "source": { "type": "GitHub", "repo": "GameTechDev/PresentMon", "assetPattern": "^PresentMon-[\\d.]+-x64\\.exe$" },
